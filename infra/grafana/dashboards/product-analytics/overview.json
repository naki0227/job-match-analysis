{
  "uid": "jm-product-overview",
  "title": "Product Analytics: Overview",
  "description": "Aggregate views in the analytics schema only (ADR-043). Read through the analytics_reader role.",
  "tags": ["job-match", "product-analytics"],
  "timezone": "Asia/Tokyo",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "label": "PostgreSQL (analytics_reader)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily active users",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day::timestamp at time zone 'Asia/Tokyo' as time, active_users from analytics.daily_active_users where day::timestamp at time zone 'Asia/Tokyo' between $__timeFrom() and $__timeTo() order by 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "New analyses per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day::timestamp at time zone 'Asia/Tokyo' as time, new_analyses, users from analytics.analysis_usage_daily where day::timestamp at time zone 'Asia/Tokyo' between $__timeFrom() and $__timeTo() order by 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Consent rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select purpose, version, consented_users, total_users, round(100.0 * consented_users / nullif(total_users, 0), 1) as percent from analytics.consent_rate order by purpose"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jev reserved units per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day::timestamp at time zone 'Asia/Tokyo' as time, jev_reserved_units from analytics.external_api_cost_daily where day::timestamp at time zone 'Asia/Tokyo' between $__timeFrom() and $__timeTo() order by 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Unknown rate per axis",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day::timestamp at time zone 'Asia/Tokyo' as time, axis_key as metric, 100.0 * unknown / nullif(evaluated, 0) as value from analytics.unknown_rate_daily where day::timestamp at time zone 'Asia/Tokyo' between $__timeFrom() and $__timeTo() order by 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evaluations by evaluator",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day::timestamp at time zone 'Asia/Tokyo' as time, evaluator_version as metric, evaluations as value from analytics.evaluator_method_daily where day::timestamp at time zone 'Asia/Tokyo' between $__timeFrom() and $__timeTo() order by 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Company interest (consented, cohort >= threshold)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select day, company_name, users from analytics.company_interest_daily where day::timestamp at time zone 'Asia/Tokyo' between $__timeFrom() and $__timeTo() order by day desc, users desc limit 100"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Axis preferences by graduation year (consented, cohort >= threshold)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select graduation_year, axis_key, users, avg_preference, avg_importance from analytics.cohort_axis_distribution order by graduation_year, axis_key"
        }
      ]
    }
  ]
}
