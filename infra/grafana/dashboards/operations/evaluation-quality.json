{
  "uid": "jm-ops-evaluation",
  "title": "Operations / Evaluation Quality",
  "description": "Counts only: how much of each page reaches the evaluator and how many axes end known, unknown or conflicting. No page text or URLs (ADR-044).",
  "tags": ["job-match", "operations"],
  "timezone": "Asia/Tokyo",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "env",
        "type": "custom",
        "query": "production,development",
        "current": {
          "text": "production",
          "value": "production"
        },
        "label": "Environment"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Axes by status (job scope)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (increase(job_match_evaluation_axes_total{deployment_environment_name=\"$env\",scope=\"job\"}[$__interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unknown ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(job_match_evaluation_axes_total{deployment_environment_name=\"$env\",scope=\"job\",status=\"unknown\"}[1d])) / sum(increase(job_match_evaluation_axes_total{deployment_environment_name=\"$env\",scope=\"job\"}[1d]))",
          "legendFormat": "unknown"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fragments available vs sent",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_fragments_available_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "available p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_fragments_sent_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "sent p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Extracted text length",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_extracted_chars_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(job_match_evaluation_extracted_chars_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Axes after rules / sent to Jev",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_unresolved_after_rules_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "after rules p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_axes_sent_to_jev_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "sent to Jev p50"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evidence per cited axis",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_evidence_per_axis_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(job_match_evaluation_evidence_per_axis_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Evaluation duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(job_match_evaluation_duration_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(job_match_evaluation_duration_bucket{deployment_environment_name=\"$env\",scope=\"job\"}[$__rate_interval])))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Jev tokens per call",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (direction) (increase(job_match_jev_tokens_total{deployment_environment_name=\"$env\"}[1d])) / ignoring(direction) group_left sum(increase(job_match_jev_calls_total{deployment_environment_name=\"$env\",outcome=\"success\"}[1d]))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ]
}
